# Server Configuration
PORT=3000

# Jira Configuration
# Required: The base URL of your Jira instance (e.g., https://your-domain.atlassian.net)
JIRA_BASE_URL=https://your-domain.atlassian.net

# Required: Your Jira account email
JIRA_EMAIL=your-email@example.com

# Required: Your Jira API token (generate at: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your-api-token-here

