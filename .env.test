# =============================================================================
# TEST ENVIRONMENT FILE
# =============================================================================
# This file contains various test scenarios for validation testing.
# Uncomment ONE scenario at a time to test different validation cases.
# =============================================================================

# Server Configuration
PORT=3000

# -----------------------------------------------------------------------------
# ✅ SCENARIO 1: Valid Configuration (DEFAULT - UNCOMMENTED)
# -----------------------------------------------------------------------------
# All values are valid - app should start successfully
JIRA_BASE_URL=https://test-domain.atlassian.net
JIRA_EMAIL=test@example.com
JIRA_API_TOKEN=test-token-123

# -----------------------------------------------------------------------------
# ❌ SCENARIO 2: Invalid URL - Plain Text
# -----------------------------------------------------------------------------
# Uncomment to test: URL validation should fail with "not a valid URL format"
# JIRA_BASE_URL=abc
# JIRA_EMAIL=test@example.com
# JIRA_API_TOKEN=test-token-123

# -----------------------------------------------------------------------------
# ❌ SCENARIO 3: Invalid URL - Missing Protocol
# -----------------------------------------------------------------------------
# Uncomment to test: URL validation should fail with "not a valid URL format"
# JIRA_BASE_URL=test-domain.atlassian.net
# JIRA_EMAIL=test@example.com
# JIRA_API_TOKEN=test-token-123

# -----------------------------------------------------------------------------
# ❌ SCENARIO 4: Invalid URL - Wrong Protocol
# -----------------------------------------------------------------------------
# Uncomment to test: URL validation should fail with "must use http:// or https://"
# JIRA_BASE_URL=ftp://test-domain.atlassian.net
# JIRA_EMAIL=test@example.com
# JIRA_API_TOKEN=test-token-123

# -----------------------------------------------------------------------------
# ❌ SCENARIO 5: Invalid Email - Plain Text
# -----------------------------------------------------------------------------
# Uncomment to test: Email validation should fail with "must be a valid email"
# JIRA_BASE_URL=https://test-domain.atlassian.net
# JIRA_EMAIL=notanemail
# JIRA_API_TOKEN=test-token-123

# -----------------------------------------------------------------------------
# ❌ SCENARIO 6: Invalid Email - Missing @ Symbol
# -----------------------------------------------------------------------------
# Uncomment to test: Email validation should fail with "must be a valid email"
# JIRA_BASE_URL=https://test-domain.atlassian.net
# JIRA_EMAIL=userexample.com
# JIRA_API_TOKEN=test-token-123

# -----------------------------------------------------------------------------
# ❌ SCENARIO 7: Invalid Email - Missing Domain
# -----------------------------------------------------------------------------
# Uncomment to test: Email validation should fail with "must be a valid email"
# JIRA_BASE_URL=https://test-domain.atlassian.net
# JIRA_EMAIL=user@
# JIRA_API_TOKEN=test-token-123

# -----------------------------------------------------------------------------
# ❌ SCENARIO 8: Missing Required Variable
# -----------------------------------------------------------------------------
# Uncomment to test: Should fail with "missing required environment variable"
# JIRA_BASE_URL=https://test-domain.atlassian.net
# JIRA_EMAIL=test@example.com
# JIRA_API_TOKEN=

# =============================================================================
# USAGE INSTRUCTIONS:
# =============================================================================
# 1. Copy this file: cp .env.test .env
# 2. Uncomment ONE scenario at a time (comment out the others)
# 3. Run: npm run dev
# 4. Observe the validation error or success message
# =============================================================================

